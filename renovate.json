{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitsDisabled",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "America/New_York",
  "schedule": [
    "before 9am on monday"
  ],
  "prConcurrentLimit": 5,
  "labels": [
    "dependencies"
  ],
  "vulnerabilityAlerts": {
    "labels": [
      "dependencies",
      "security"
    ],
    "schedule": [
      "at any time"
    ]
  },
  "packageRules": [
    {
      "description": "Swift packages (Package.swift and XcodeGen project.yml): one weekly PR for minor/patch updates.",
      "matchManagers": [
        "swift",
        "xcodegen"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Swift packages"
    },
    {
      "description": "Swift package major updates get their own PR and need approval on the Dependency Dashboard.",
      "matchManagers": [
        "swift",
        "xcodegen"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "GitHub Actions: group all updates into one PR.",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    }
  ]
}
